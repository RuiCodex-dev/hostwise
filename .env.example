# Copy to .env (never commit it) or set these in your host's secret store.
QLOO_API_KEY=replace-with-your-event-credential
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional: hard cap on live Qloo calls per UTC day (protects the event quota)
QLOO_DAILY_CALL_CAP=1500
# Optional LLM narrator (the agent works without it)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# HOSTWISE_OPENAI_API_KEY=
# HOSTWISE_OPENAI_BASE_URL=https://api.openai.com/v1
# HOSTWISE_OPENAI_MODEL=gpt-4o-mini
# Optional: behind your own reverse proxy, the one header it sets with the client address
# (e.g. x-real-ip). Leave unset on Fly.io/Render.
# TRUST_PROXY_HEADER=
